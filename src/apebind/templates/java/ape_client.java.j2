    private static Object waitForJsonResult(
        ProcessSession session,
        Path resultPath,
        Map<String, Object> resultConfig
    ) {
        if (resultPath == null) {
            throw new IllegalStateException("JSON result path was not created");
        }

        Double timeoutSeconds = number(resultConfig.get("ready_timeout_seconds"));
        if (timeoutSeconds == null) {
            return null;
        }

        long deadline = System.nanoTime() + Math.round(timeoutSeconds * 1_000_000_000.0);
        long lastSize = -1;
        int stableCount = 0;

        while (System.nanoTime() < deadline) {
            try {
                if (Files.exists(resultPath)) {
                    long size = Files.size(resultPath);

                    if (size > 0 && size == lastSize) {
                        stableCount += 1;

                        if (stableCount >= 2) {
                            return readJsonResult(resultPath, resultConfig);
                        }
                    } else {
                        stableCount = 0;
                    }

                    lastSize = size;
                }
            } catch (IOException caught) {
                throw new IllegalStateException("Failed to inspect APE JSON result", caught);
            }

            if (!session.running()) {
                session.waitFor();

                if (!Files.exists(resultPath)) {
                    throw new IllegalStateException(
                        "APE exited before producing the JSON result file"
                    );
                }

                return readJsonResult(resultPath, resultConfig);
            }

            try {
                Thread.sleep(20);
            } catch (InterruptedException caught) {
                Thread.currentThread().interrupt();
                throw new IllegalStateException(
                    "Interrupted while waiting for APE JSON result",
                    caught
                );
            }
        }

        throw new APETimeoutException(session.argv(), timeoutSeconds);
    }


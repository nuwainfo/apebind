                self._process.stdout.close()

        return_code = _normalize_ape_return_code(self._process.wait(timeout=timeout))
        self._close_stdin_source()
        self._wait_for_stdin()
        self._wait_for_event_channel()
        self._wait_for_output(self._stopped_by_client)

        process_result = APEProcessResult(
            self._argv,
            return_code,
            self._captured_stdout().decode('utf-8', errors='replace'),
            self._captured_stderr().decode('utf-8', errors='replace'),
        )
        self._process_result = process_result

        if return_code != 0 and not self._stopped_by_client:
            raise APEProcessError(process_result)

        return 0 if self._stopped_by_client else return_code


def _normalize_ape_return_code(return_code: int) -> int:
    """Convert Cosmopolitan's Windows wait status to the program exit code."""
    if os.name == 'nt' and return_code > 0 and return_code % 256 == 0:
        return return_code // 256

    return return_code


def _is_wsl2() -> bool:
    try:
        version = Path('/proc/version').read_text(encoding='utf-8').lower()
    except OSError:
        return False

    return 'microsoft' in version or 'wsl' in version


def _wsl_interop_guidance(stderr: str) -> str:
    if 'tlserror([0x6300])' not in stderr.lower() or not _is_wsl2():
        return ''

    return (
        '\n\nWSL2 may be executing this .com APE through Windows interop. '
        'Run the following command in WSL, then restart the WSL session:\n\n'
        "    sudo sh -c 'echo -1 > /proc/sys/fs/binfmt_misc/WSLInterop'"
    )


def _extract_field(value: Any, field_path: str | None) -> Any:
    if not field_path:
        return value

    current = value

    for part in field_path.split('.'):
        current = current[part]

    return current



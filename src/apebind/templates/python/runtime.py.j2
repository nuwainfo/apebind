        return self._wait(timeout, require_streamed_stdout=True)

    def _cleanup_runtime_files(self) -> None:
        if self._runtime_files is None:
            return

        runtime_files = self._runtime_files
        self._runtime_files = None
        runtime_files.cleanup()

    def stop(self, timeout: float = 5.0) -> None:
        if not self.running:
            try:
                self._wait(require_streamed_stdout=False)
            finally:
                self._cleanup_runtime_files()

            return

        self._stopped_by_client = True
        self._close_stdin_source()
        self._process.terminate()

        try:
            self._process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            self._process.kill()
            self._process.wait()

        try:
            if (
                not self._capture_stdout
                and self._process.stdout is not None
                and not self._process.stdout.closed
            ):
                self._process.stdout.close()

            self._wait_for_event_channel()
            self._wait_for_output(True)
        finally:
            self._cleanup_runtime_files()

    def close(self) -> None:
        if self.running:
            self.stop()
            return

        try:
            self._wait(require_streamed_stdout=False)
        finally:
            self._cleanup_runtime_files()

    def __enter__(self):
        return self

    def __exit__(self, exception_type, exception_value, traceback_value) -> None:
        del exception_type, exception_value, traceback_value
        self.close()


class APEClient:
    def __init__(
        self,
        binary_path: Path,
        operations: dict[str, dict[str, Any]],
        runtime: dict[str, Any] | None = None,
    ):
        self._binary_path = binary_path.resolve()
        self._operations = operations
        self._runtime = {} if runtime is None else runtime

    @staticmethod
    def _multiple_values(value: Any) -> Iterable[Any]:
        if isinstance(value, (str, bytes, os.PathLike)):
            return (value,)

        if isinstance(value, Iterable):
            return value

        return (value,)

    @classmethod
    def _append_optional_value(
        cls,
        argv: list[str],
        option: dict[str, Any],
        value: Any,
    ) -> bool:
        if not option['value_optional']:
            return False

        if value is None or value is False:
            return True

        argv.append(option['primary_flag'])

        if value is True:
            return True

        argv.append(str(value))
        return True

    @staticmethod
    def _runtime_path(
        option: dict[str, Any],
        runtime_files: _RuntimeFiles | None,
        operation: dict[str, Any],
    ) -> tuple[str, Path]:
        if runtime_files is None:
            raise RuntimeError('Runtime-owned option has no runtime files')

        role = option.get('runtime_role', 'result')
        path = runtime_files.path(role)
        if path is None:
            raise RuntimeError(f'Runtime-owned option has no {role} path')

        if role == 'events':
            flag = operation['events']['source']['option_flag']
        else:
            flag = operation['result']['option_flag']

        return flag, path

    @classmethod
    def _append_options(
        cls,
        argv: list[str],
        options: list[dict[str, Any]],
        values: dict[str, Any],
        runtime_files: _RuntimeFiles | None,
        operation: dict[str, Any],
    ) -> None:
        for option in options:
            if option['runtime_owned']:
                flag, path = cls._runtime_path(option, runtime_files, operation)
                argv.extend([flag, str(path)])
                continue

            value = values.get(option['api_name'])
            if option['boolean']:
                if value:
                    argv.append(option['primary_flag'])

                continue

            if cls._append_optional_value(argv, option, value):
                continue

            if value is None:
                if option['required']:
                    raise TypeError(
                        f"Missing required argument: {option['api_name']}"
                    )

                continue

            if option['multiple']:
                for item in cls._multiple_values(value):
                    argv.extend([option['primary_flag'], str(item)])

                continue

            argv.extend([option['primary_flag'], str(value)])

    @classmethod
    def _append_positionals(
        cls,
        argv: list[str],
        positionals: list[dict[str, Any]],
        values: dict[str, Any],
    ) -> None:
        for positional in positionals:
            value = values.get(positional['api_name'])
            if value is None:
                if positional['required']:
                    raise TypeError(
                        f"Missing required argument: {positional['api_name']}"
                    )

                continue

            if positional['multiple']:
                argv.extend(str(item) for item in cls._multiple_values(value))
                continue

            argv.append(str(value))

    def _build_argv(
        self,
        operation: dict[str, Any],
        values: dict[str, Any],
        runtime_files: _RuntimeFiles | None,
    ) -> list[str]:
        argv: list[str] = []

        for level_index, level in enumerate(operation['levels']):
            if level_index > 0:
                argv.append(level['token'])

            self._append_options(
                argv,
                level['options'],
                values,
                runtime_files,
                operation,
            )
            self._append_positionals(argv, level['positionals'], values)

        return argv

    def _environment(self) -> dict[str, str]:
        environment = os.environ.copy()

        for variable_name in self._runtime.get('env_unset', []):
            environment.pop(variable_name, None)

        return environment

    def _launch_command(self, argv: list[str]) -> list[str]:
        executable = str(self._binary_path)
        if os.name == 'nt':
            return [executable, *argv]

        return ['/bin/sh', '-c', 'exec "$0" "$@"', executable, *argv]

    def _run_command(
        self,
        argv: list[str],
        timeout_seconds: float | None = None,
    ) -> APEProcessResult:
        process = subprocess.run(
            self._launch_command(argv),
            capture_output=True,
            text=True,
            encoding='utf-8',
            errors='replace',
            check=False,
            timeout=timeout_seconds,
            env=self._environment(),
        )
        result = APEProcessResult(
            tuple(argv),
            _normalize_ape_return_code(process.returncode),
            process.stdout,
            process.stderr,
        )

        if result.return_code != 0:
            raise APEProcessError(result)

        return result

    def _start_persistent(
        self,
        argv: list[str],
        runtime_files: _RuntimeFiles | None,
        event_config: dict[str, Any] | None = None,
        stdin_source: Any = None,
        capture_stdout: bool = True,
    ) -> ProcessSession:
        process = subprocess.Popen(
            self._launch_command(argv),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            stdin=subprocess.PIPE if stdin_source is not None else None,
            env=self._environment(),
        )

        session = ProcessSession(
            process,
            argv,
            runtime_files,
            event_config,
            capture_stdout,
        )

        if stdin_source is not None:
            session.attach_stdin(stdin_source)

        return session

    def _decode_result(
        self,
        result: APEProcessResult,
        result_path: Path | None,
        result_config: dict[str, Any],
    ) -> Any:
        result_format = result_config['format']
        if result_format == 'command':
            return result

        if result_format == 'text':
            return result.stdout.strip() if result_config['strip'] else result.stdout

        if result_format == 'json':
            value = json.loads(result.stdout)
            return _extract_field(value, result_config['field'])

        if result_format == 'json_file':
            if result_path is None or not result_path.exists():
                raise RuntimeError('APE did not create the configured JSON result file')

            value = json.loads(result_path.read_text(encoding='utf-8'))
            return _extract_field(value, result_config['field'])

        raise RuntimeError(f'Unsupported result format: {result_format}')

    def _run_oneshot(
        self,
        argv: list[str],
        runtime_files: _RuntimeFiles | None,
        operation: dict[str, Any],
    ) -> Any:
        result_path = None if runtime_files is None else runtime_files.path('result')

        try:
            result = self._run_command(
                argv,
                operation['process']['timeout_seconds'],
            )
            return self._decode_result(result, result_path, operation['result'])
        finally:
            if runtime_files is not None:
                runtime_files.cleanup()

    def _read_json_result(
        self,
        result_path: Path,
        result_config: dict[str, Any],
    ) -> Any:
        value = json.loads(result_path.read_text(encoding='utf-8'))
        return _extract_field(value, result_config['field'])

    def _wait_for_json_result(
        self,
        session: ProcessSession,
        result_path: Path | None,
        result_config: dict[str, Any],
    ) -> Any:
        if result_path is None:
            raise RuntimeError('JSON result path was not created')

        timeout = float(result_config['ready_timeout_seconds'])
        deadline = time.monotonic() + timeout
        last_size = -1
        stable_count = 0

        while time.monotonic() < deadline:
            if result_path.exists():
                size = result_path.stat().st_size
                if size > 0 and size == last_size:
                    stable_count += 1
                    if stable_count >= 2:
                        return self._read_json_result(result_path, result_config)
                else:
                    stable_count = 0

                last_size = size

            if not session.running:
                session.wait()
                if result_path.exists() and result_path.stat().st_size > 0:
                    return self._read_json_result(result_path, result_config)

                raise RuntimeError('APE exited before producing the JSON result file')

            time.sleep(0.02)

        raise TimeoutError(f'JSON result was not ready within {timeout} seconds')

    def invoke(self, operation_name: str, values: dict[str, Any]) -> Any:
        operation = self._operations[operation_name]
        result_config = operation['result']
        runtime_files = _RuntimeFiles.create(operation)

        try:
            argv = self._build_argv(operation, values, runtime_files)
        except Exception:
            if runtime_files is not None:
                runtime_files.cleanup()

            raise

        if operation['execution'] == 'persistent':
            session = self._start_persistent(
                argv,
                runtime_files,
                operation.get('events'),
                values.get('stdin'),
                values.get('_apebind_capture_stdout', True),
            )
            result_path = None if runtime_files is None else runtime_files.path('result')

            try:
                if (
                    result_config['format'] == 'json_file'
                    and result_config['ready_timeout_seconds'] is not None
                ):
                    session.set_result(
                        self._wait_for_json_result(session, result_path, result_config)
                    )
            except Exception:
                if session.running:
                    session.stop()
                else:
                    session._cleanup_runtime_files()

                raise

            return session

        return self._run_oneshot(argv, runtime_files, operation)

    def raw(self, arguments: list[str], persistent: bool = False):
        argv = [str(value) for value in arguments]
        if persistent:
            return self._start_persistent(argv, None)

        return self._run_command(argv)

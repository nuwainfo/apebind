class APEProcessError(RuntimeError):
    def __init__(self, result: APEProcessResult):
        super().__init__(
            f'APE exited with code {result.return_code}: {result.stderr.strip()}'
            f'{_wsl_interop_guidance(result.stderr)}'
        )
        self.result = result



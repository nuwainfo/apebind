  _appendPositionals(argv, positionals, values) {
    for (const positional of positionals) {
      const value = values[positional.api_name];
      if (value === undefined || value === null) {
        if (positional.required) {
          throw new TypeError(`Missing required argument: ${positional.api_name}`);
        }

        continue;
      }

      if (positional.multiple) {
        for (const item of this._multipleValues(value)) {

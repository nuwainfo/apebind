    } finally {
      if (runtimeFiles !== null) {
        await runtimeFiles.cleanup();
      }
    }
  }

  async _readJsonResult(resultPath, resultConfig) {
    const value = JSON.parse(await readFile(resultPath, 'utf8'));
    return extractField(value, resultConfig.field);
  }

  async _waitForJsonResult(session, resultPath, resultConfig) {
    if (resultPath === null) {
      throw new Error('JSON result path was not created');
    }

    const timeoutSeconds = Number(resultConfig.ready_timeout_seconds);
    const deadline = Date.now() + timeoutSeconds * 1000;
    let lastSize = -1;
    let stableCount = 0;

    while (Date.now() < deadline) {
      try {
        const fileStat = await stat(resultPath);
        if (fileStat.size > 0 && fileStat.size === lastSize) {
          stableCount += 1;
          if (stableCount >= 2) {
            return await this._readJsonResult(resultPath, resultConfig);
          }
        } else {
          stableCount = 0;
        }

        lastSize = fileStat.size;
      } catch (error) {
        if (error.code !== 'ENOENT') {
          throw error;
        }
      }

      if (!session.running) {
        await session.wait();

        try {
          return await this._readJsonResult(resultPath, resultConfig);
        } catch (error) {
          if (error.code !== 'ENOENT') {
            throw error;
          }

          throw new Error('APE exited before producing the JSON result file');
        }
      }

      await sleep(20);
    }

    throw new APETimeoutError(session.argv, timeoutSeconds);
  }

  async invoke(operationName, values = {}) {
    const operation = this._operations[operationName];
    if (operation === undefined) {
      throw new Error(`Unknown operation: ${operationName}`);
    }

    const runtimeFiles = await RuntimeFiles.create(operation);
    let argv;

    try {
      argv = this._buildArgv(operation, values, runtimeFiles);
    } catch (error) {
      if (runtimeFiles !== null) {
        await runtimeFiles.cleanup();
      }

      throw error;
    }

    if (operation.execution === 'persistent') {
      const session = this._startPersistent(
        argv,
        runtimeFiles,
        operation.events ?? null,
        values.stdin ?? null,
        { captureStdout: values._apebindCaptureStdout ?? true },
      );
      const resultPath = runtimeFiles?.path('result') ?? null;

      try {
        if (
          operation.result.format === 'json_file'
          && operation.result.ready_timeout_seconds !== null
        ) {
          session.setResult(
            await this._waitForJsonResult(session, resultPath, operation.result),
          );
        }
      } catch (error) {
        if (session.running) {
          await session.stop();
        } else {
          await session._cleanupRuntimeFiles();
        }

        throw error;
      }

      return session;
    }

    return this._runOneshot(argv, runtimeFiles, operation);
  }

  async raw(arguments_, { persistent = false, timeoutSeconds = null } = {}) {
    const argv = arguments_.map((value) => String(value));
    if (persistent) {
      return this._startPersistent(argv, null);
    }

    return this._runCommand(argv, timeoutSeconds);
  }
}

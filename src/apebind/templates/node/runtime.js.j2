  _appendOptionalValue(argv, option, value) {
    if (!option.value_optional) {
      return false;
    }

    if (value === undefined || value === null || value === false) {
      return true;
    }

    argv.push(option.primary_flag);

    if (value === true) {
      return true;
    }

    argv.push(String(value));
    return true;
  }

  _runtimePath(option, runtimeFiles, operation) {
    if (runtimeFiles === null) {
      throw new Error('Runtime-owned option has no runtime files');
    }

    const role = option.runtime_role ?? 'result';
    const path = runtimeFiles.path(role);
    if (path === null) {
      throw new Error(`Runtime-owned option has no ${role} path`);
    }

    const flag = role === 'events'
      ? operation.events.source.option_flag
      : operation.result.option_flag;

    return { flag, path };
  }

  _appendOptions(argv, options, values, runtimeFiles, operation) {
    for (const option of options) {
      if (option.runtime_owned) {
        const runtimePath = this._runtimePath(option, runtimeFiles, operation);
        argv.push(runtimePath.flag, runtimePath.path);
        continue;
      }

      const value = values[option.api_name];
      if (option.boolean) {
        if (value) {
          argv.push(option.primary_flag);
        }

        continue;
      }

      if (this._appendOptionalValue(argv, option, value)) {
        continue;
      }

      if (value === undefined || value === null) {
        if (option.required) {
          throw new TypeError(`Missing required argument: ${option.api_name}`);
        }

        continue;
      }

      if (option.multiple) {
        for (const item of this._multipleValues(value)) {
          argv.push(option.primary_flag, String(item));
        }

        continue;
      }

      argv.push(option.primary_flag, String(value));
    }
